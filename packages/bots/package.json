{
  "name": "@colonist/bots",
  "version": "0.1.0",
  "private": true,
  "description": "Bots con IA heurística y MCTS para jugar contra la computadora",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p pruebas/tsconfig.json"
  },
  "dependencies": {
    "@colonist/motor-compartido": "workspace:*"
  }
}
