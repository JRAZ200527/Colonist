{
  "name": "@colonist/motor-compartido",
  "version": "0.1.0",
  "private": true,
  "description": "Motor de juego compartido: matemáticas hexagonales, reglas y máquina de estados",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p pruebas/tsconfig.json"
  }
}
