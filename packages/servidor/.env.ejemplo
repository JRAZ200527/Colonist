# Copia este archivo como .env para desarrollo local.

# Puerto del servidor (en Render lo asigna la plataforma).
PORT=3000

# Orígenes adicionales permitidos por CORS, separados por comas.
CORS_ORIGENES_EXTRA=

# Base de datos PostgreSQL. Sin valor, el servidor guarda el ranking solo en memoria.
# Para un Postgres local sin instalar nada:
#   pnpm --filter @colonist/servidor db:local -- --name colonist --detach
# copia aquí la URL que muestra y aplica las migraciones:
#   pnpm --filter @colonist/servidor exec prisma migrate deploy
DATABASE_URL=
